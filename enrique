local function getBestTarget(player, maxAngle)
	local char = player.Character
	if not char then return nil end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local facing = hrp.CFrame.LookVector
	local bestTarget = nil
	local bestScore = math.huge 

	for _, v in ipairs(workspace:GetChildren()) do
		if v:FindFirstChild("UpperTorso")
			and v:FindFirstChild("Humanoid")
			and v.Humanoid.Health > 0
			and v ~= char then

			local torso = v.UpperTorso
			local toTarget = (torso.Position - camera.CFrame.Position).Unit

			
			local dot = facing:Dot(toTarget)
			local threshold = math.cos(math.rad(maxAngle))

			if dot >= threshold then
			
				local dist = (torso.Position - hrp.Position).Magnitude

				if dist < bestScore then
					bestScore = dist
					bestTarget = v.Head
				end
			end
		end
	end

	return bestTarget
end
plrtable = {}
RunService.RenderStepped:Connect(function()
	local char = player.Character
	if not char then return end

	
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local camPos = hrp.Position + Vector3.new(0, 3, 0)
	local upperTorso = getBestTarget(player, 30)
	if upperTorso then
		
		camera.CFrame = CFrame.new(camPos, upperTorso.Position)
		hrp.CFrame = CFrame.new(hrp.Position, upperTorso.Position)
		
	else
		camera.CameraType = Enum.CameraType.Custom
	end
	for i,v in pairs(game.Workspace:GetChildren()) do
		if v:FindFirstChild("Humanoid") then
			for i,x in pairs (v:GetChildren()) do
				if x:IsA("BasePart") and  not x:FindFirstChild("Highlight") then
					table.insert(plrtable,x)
					local highlight = Instance.new("Highlight")
					highlight.Parent = x
					highlight.FillTransparency = 0.5
					highlight.OutlineTransparency = 0

					highlight.OutlineColor = Color3.new(0,1,0)
					highlight.FillColor = Color3.new(0,1,0)

				end
			end


		end
	end
end)

